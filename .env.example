# =============================================================
# FleetSphere — Environment Variables Example
# Copy this file to backend/.env and fill in your values
# NEVER commit .env to git
# =============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/fleetsphere
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/fleetsphere

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Client URL (CORS) ───────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email (Optional — for password reset) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=FleetSphere <noreply@fleetsphere.app>
